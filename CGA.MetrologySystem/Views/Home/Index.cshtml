@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mt-5">

    <h1 class="display-4 fw-bold text-primary">
        CGA Metrology System
    </h1>

    <p class="lead mt-3">
        Sistema de Gestión Metrológica Industrial
    </p>

    <hr class="my-4" />

    <p class="fs-5">
        Plataforma desarrollada para la administración y seguimiento de equipos metrológicos,
        calibraciones, verificaciones y control documental.
    </p>

</div>

<div class="row mt-5">

    <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h5>ASP.NET Core</h5>
                <p class="text-success mb-0">
                    ✓ Aplicación Operativa
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h5>Docker</h5>
                <p class="text-success mb-0">
                    ✓ Lista para Contenerización
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h5>Kubernetes</h5>
                <p class="text-success mb-0">
                    ✓ Lista para Despliegue
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <h5>Argo CD</h5>
                <p class="text-success mb-0">
                    ✓ Preparada para GitOps
                </p>
            </div>
        </div>
    </div>

</div>

<div class="card mt-4 shadow-sm">
    <div class="card-body">

        <h4>Descripción del Proyecto</h4>

        <p>
            CGA Metrology System es una aplicación web desarrollada en ASP.NET Core
            orientada a la gestión de procesos metrológicos industriales.
        </p>

        <p>
            Esta versión corresponde a una implementación académica utilizada para
            demostrar procesos de contenerización con Docker, despliegue en Kubernetes
            y sincronización continua mediante Argo CD.
        </p>

    </div>
</div>